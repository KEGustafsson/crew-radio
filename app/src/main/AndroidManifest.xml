<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The buzz that confirms a hardware talk key (PttService.buzz). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- LanTransport watches the Wi-Fi interface with ConnectivityManager.registerNetworkCallback. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth Classic (RFCOMM/SPP) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Only to cancel an in-progress system scan before dialling out; optional at runtime. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" />

    <!-- Wi-Fi Aware discovery. attach() needs CHANGE_WIFI_STATE; the data path goes
         through ConnectivityManager.requestNetwork, which needs CHANGE_NETWORK_STATE. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- Nothing here is required to install: a phone with no Bluetooth still has WLAN, a phone
         with no Wi-Fi Aware still has Bluetooth, and a managed fleet must not be filtered out
         of the store over a radio the crew does not use on that phone. -->
    <uses-feature android:name="android.hardware.wifi.aware" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Package visibility (Android 11 and later): binding to the on-device speech recogniser and to
      a text-to-speech engine needs them to be visible, and without these the binding fails
      silently rather than reporting anything.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      usesCleartextTraffic: the boat's Signal K server. It lives on the vessel's own LAN, on an
      address the crew types or the app finds over mDNS, and it is almost always plain HTTP: a boat
      server has no public name and no certificate anybody can issue for 192.168.1.9. Since the host
      cannot be known in advance it cannot be listed in a network security config, so cleartext is
      permitted app-wide here (a base-config saying the same is what lint calls an insecure base
      configuration; the manifest flag is the same permission, stated where it is read).

      What that is worth knowing about, and why it is bounded: this is the app's ONLY HTTP traffic.
      The channel itself never uses it — every packet between phones is AES-256-GCM under the
      channel key over UDP, Bluetooth RFCOMM or Wi-Fi Aware, and none of it goes through this stack.
      What crosses in the clear is a Signal K read, an announcement, and the token that authorises
      them, all on the boat's own network. docs/SECURITY.md says so in the threat model.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.PTT"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true">

        <!-- Managed configuration: an EMM may provision the channel and the network settings. -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StatusActivity"
            android:label="@string/menu_status"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.PTT.Settings" />

        <activity
            android:name=".SettingsActivity"
            android:label="@string/menu_settings"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.PTT.Settings" />

        <!-- Keeps the engine alive with the screen off; see PttService. -->
        <service
            android:name=".PttService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />
        <!-- The channel as a self-managed call while a Bluetooth headset is in use: see CallService. -->
        <service
            android:name=".CallService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
