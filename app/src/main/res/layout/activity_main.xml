<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: channel name, who is aboard, menu. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/channelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/crew_channel"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:textSize="12sp"
                android:textColor="@color/text_teal_dim"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/crewName"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="@string/app_name"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="27sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="@color/primary"
                android:maxLines="1"
                android:layout_marginEnd="8dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/peersBox"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:background="@drawable/bg_outline">
            <ImageView
                android:id="@+id/peersIcon"
                android:layout_width="22dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_signal"
                app:tint="@color/primary"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/peerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                tools:text="0"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_settings" />
    </LinearLayout>

    <!-- Transport tiles. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/tileLan"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_tile_off">
            <ImageView android:id="@+id/tileLanIcon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_wifi" android:contentDescription="@null" />
            <TextView android:id="@+id/tileLanLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/tile_lan" android:fontFamily="monospace" android:letterSpacing="0.08" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tileBt"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_tile_off">
            <ImageView android:id="@+id/tileBtIcon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_bluetooth" android:contentDescription="@null" />
            <TextView android:id="@+id/tileBtLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/tile_bt" android:fontFamily="monospace" android:letterSpacing="0.08" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tileAware"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_tile_off">
            <ImageView android:id="@+id/tileAwareIcon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_aware" android:contentDescription="@null" />
            <TextView android:id="@+id/tileAwareLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/tile_aware" android:fontFamily="monospace" android:letterSpacing="0.08" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bluetooth peer, only while Bluetooth is on. -->
    <TextView
        android:id="@+id/peerButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:textSize="13sp"
        android:textColor="@color/secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/bg_outline"
        android:visibility="gone" />

    <!-- The channel switch: on it or off it, said quietly. The whole row toggles. -->
    <LinearLayout
        android:id="@+id/channelRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_outline"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:id="@+id/channelState"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:maxLines="1"
            android:ellipsize="end" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/channelSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Volume: mute (the app's own, in the mixer), then the phone's call volume as a slider and a step number.
         The range is set in code from the stream in use (the volume keys are a talk key on channel). -->
    <LinearLayout
        android:id="@+id/volumeRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_outline">
        <ImageButton
            android:id="@+id/muteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_volume"
            app:tint="@color/secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/volume_mute" />
        <com.google.android.material.slider.Slider
            android:id="@+id/volumeSlider"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:valueFrom="0"
            android:valueTo="7"
            android:stepSize="1"
            android:value="7"
            android:contentDescription="@string/volume_slider"
            app:labelBehavior="gone"
            app:tickVisible="false"
            app:thumbColor="@color/primary"
            app:thumbWidth="22dp"
            app:thumbHeight="22dp"
            app:thumbElevation="0dp"
            app:thumbTrackGapSize="0dp"
            app:trackStopIndicatorSize="0dp"
            app:trackInsideCornerSize="0dp"
            app:trackColorActive="@color/primary"
            app:trackColorInactive="@color/outline"
            app:trackHeight="6dp"
            app:haloColor="@color/primary_container" />
        <TextView
            android:id="@+id/volumeValue"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            tools:text="7"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/text" />
    </LinearLayout>

    <!-- Ask the boat. Hidden altogether unless a Signal K server is configured and the setting is
         on, like the Bluetooth peer row above: a crew that does not use Signal K never sees it.
         Kept well clear of the disc on purpose — reaching for TALK and hitting this instead would
         lose a transmission the sender believed had gone out. -->
    <LinearLayout
        android:id="@+id/askRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_outline"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <ImageView
            android:id="@+id/askIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_ask"
            app:tint="@color/primary"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/askLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/ask_row"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:textSize="13sp"
            android:textColor="@color/secondary"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- The talk disc: as large a circle as the remaining space allows (sized in code to min(w, h)). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/talkArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pttButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:fontFamily="monospace"
            android:textSize="40sp"
            android:letterSpacing="0.14"
            android:textStyle="bold"
            android:textAlignment="center"
            android:text="@string/ptt_talk"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PTT.Circle"
            app:strokeWidth="12dp"
            app:strokeColor="@color/outline"
            app:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
