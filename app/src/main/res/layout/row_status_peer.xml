<?xml version="1.0" encoding="utf-8"?>
<!-- A crew member on the Status screen: the dot/name/meta row from the radio look, plus one line of detail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <View
            android:id="@+id/dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot" />
        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="17sp"
            android:textColor="@color/text"
            android:maxLines="1"
            android:ellipsize="end" />
        <!-- The link meter: how many of its packets get here (Peer.level), the same bars as the main screen's header. -->
        <ImageView
            android:id="@+id/level"
            android:layout_width="22dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_signal"
            app:tint="@color/primary"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/build"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/error"
            android:visibility="gone" />
        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:textSize="12sp"
            android:textColor="@color/text_dim" />
    </LinearLayout>
    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="@color/text_dim" />
</LinearLayout>
