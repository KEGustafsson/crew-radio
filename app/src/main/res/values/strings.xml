    <string name="pref_name_title">My name</string>
    <string name="pref_name_message">What the others see in their crew list, e.g. Skipper. Leave empty to use the name of this phone. Up to 32 bytes; applies immediately.</string>
    <string name="pref_crew_name_title">Channel name</string>
    <string name="pref_crew_name_message">Shown large at the top of the main screen: the boat or the crew, e.g. NORTH STAR. Up to 24 characters; empty shows the app name.</string>
    <string name="pref_channel_key_title">Channel key</string>
    <string name="pref_channel_key_message">Every phone on the crew must have the same key: it encrypts everything on the air and only phones that have it can join. This phone made one for you; read it out or type it into the others, or type theirs here. 12 to 64 plain characters. Takes effect on the next join, so leave the channel and join again after changing it.</string>
    <string name="pref_key_show_title">Show the key</string>
    <string name="pref_key_show_summary">Read it out to the crew; it is never shown in full anywhere else.</string>
    <string name="pref_key_share_title">Share the key</string>
    <string name="pref_key_share_summary">Send it to another phone. Anyone who sees it can join the channel.</string>
    <string name="pref_key_new_title">New random key</string>
    <string name="pref_key_new_summary">Makes a fresh key on this phone. Every other phone on the crew has to be given the new one.</string>
    <string name="pref_full_duplex_title">Full duplex</string>
    <string name="pref_full_duplex_on">The big button toggles the mic; everyone is heard at once. Best with a headset.</string>
    <string name="pref_full_duplex_off">Hold the big button to talk; others are muted while you hold it.</string>
    <string name="pref_hw_button_title">Talk button</string>
    <string name="pref_hw_button_dialog">Which buttons key the mic</string>
    <string name="pref_hw_button_help">Press once: mic on. Press again: mic off. Holding a headset button talks for as long as you hold it. A volume key works the same, press for press.</string>
    <string name="pref_audio_route_title">Audio output</string>
    <string name="pref_audio_route_dialog">Where the voice goes</string>
    <string name="pref_headset_vox_title">Voice keys the mic</string>
    <string name="pref_headset_vox_summary">With a Bluetooth headset: just speak. The mic keys itself when you talk and un-keys 1.5 s after you stop; mute the headset to be sure you are off air. For headsets whose button does not reach the app. With the phone at your ear it is always on, on any output but the loudspeaker.</string>
    <string name="pref_proximity_title">Phone at the ear</string>
    <string name="pref_proximity_summary">Use the proximity sensor: lifted to the ear, the sound moves to the earpiece, the screen goes dark and your voice keys the mic. Off if the sensor misfires in a pocket or under spray: the loudspeaker stays, the screen stays on, and voice keying on the phone works only with the earpiece output chosen.</string>
    <string name="pref_cue_tones_title">Talk key tones</string>
    <string name="pref_cue_tones_summary">One tone in the ear when a talk key keys the mic, two when it un-keys it. Off: the buzz on the phone only.</string>
    <string name="pref_headset_call_title">Headset button hangs up</string>
    <string name="pref_headset_call_summary">Only if a Bluetooth headset\'s button does nothing here: some headsets send a hang-up instead of a media key. This registers the channel with the phone as a call while such a headset is in use, so the hang-up becomes the talk key. It shows on car kits as a call, and a phone call puts the channel on hold.</string>
    <string name="pref_keep_screen_on_title">Keep screen on</string>
    <string name="pref_keep_screen_on_summary">While on the channel. Turn off when a headset or the volume keys do the talking.</string>
    <string name="pref_relay_title">Relay</string>
    <string name="pref_relay_summary">Forward what this phone hears to its other links, so phones out of each other\'s range still connect through it. Leave on.</string>
    <string name="pref_opus_title">Opus compression</string>
    <string name="pref_opus_summary">About a tenth of the bandwidth of raw audio. Falls back to raw by itself if this phone cannot encode Opus. Applies the next time the mic is keyed.</string>
    <string name="pref_group_title">Multicast group</string>
    <string name="pref_group_message">An IPv4 multicast address, 224.0.0.0 to 239.255.255.255. Every phone on the crew must use the same one.</string>
    <string name="pref_port_title">UDP port</string>
    <string name="pref_port_message">1024 to 65535, the same on every phone.</string>
    <string name="pref_hops_title">Hop limit</string>
    <string name="pref_hops_message">How many relays a packet may cross, 1 to 16. Also caps what this phone forwards for others. Applies immediately.</string>

