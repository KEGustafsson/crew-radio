<resources>
    <!-- Material 3, dark only: the Radio design is teal on charcoal (see colors.xml). -->
    <style name="Theme.PTT" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorSurface">@color/surface</item>
        <!-- The ground the screens are drawn on; the layouts do not paint it again (Overdraw). -->
        <item name="android:windowBackground">@color/surface</item>
        <!-- Edge to edge (targetSdk 35 and later enforce it): the bars are transparent and the activities
             pad themselves with the window insets. The charcoal ground shows through, so the bar
             icons have to be the light set. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- The ask sheet's ground is the sheet's own, painted once (see the styles below). -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.PTT.BottomSheet</item>
    </style>

    <!-- A bottom sheet on the Radio palette: Material's own 28 dp top corners, on surface_card. The
         sheet container paints this, so sheet_ask.xml paints no background of its own (Overdraw). -->
    <style name="ThemeOverlay.PTT.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.PTT.BottomSheet</item>
    </style>
    <style name="Widget.PTT.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface_card</item>
    </style>

    <!-- Status and Settings: no window action bar, a MaterialToolbar in the layout instead, so the
         toolbar can take the status-bar inset like everything else. The preference list needs its
         own theme overlay. -->
    <style name="Theme.PTT.Settings" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <!-- The talk disc: a MaterialButton clipped to a circle, its stroke drawn as the ring. -->
    <style name="ShapeAppearance.PTT.Circle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
