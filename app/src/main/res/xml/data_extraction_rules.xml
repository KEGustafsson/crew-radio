<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later. The only thing this app stores is the default SharedPreferences,
  and that file holds the channel key: the one secret that lets a phone hear the crew.
  It must not ride along to a cloud backup or to a new phone during a device transfer,
  where it would leave the crew's key in a place nobody chose. The crew types it in.
  See docs/SECURITY.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
