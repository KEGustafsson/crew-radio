<?xml version="1.0" encoding="utf-8"?>
<!-- Every user-visible string here lives in strings.xml, so the screen can be translated in one
     place; the keys match Prefs and res/xml/app_restrictions.xml. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_me">
        <EditTextPreference
            app:key="display_name"
            app:title="@string/pref_name_title"
            app:dialogMessage="@string/pref_name_message"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_channel">
        <EditTextPreference
            app:key="crew_name"
            app:title="@string/pref_crew_name_title"
            app:dialogMessage="@string/pref_crew_name_message"
            app:useSimpleSummaryProvider="true" />
        <!-- The summary is a mask ("•••• •••• ab3f"), set in SettingsActivity: the key is the one
             secret on the phone and a settings list is read over shoulders. -->
        <EditTextPreference
            app:key="channel_key"
            app:title="@string/pref_channel_key_title"
            app:dialogMessage="@string/pref_channel_key_message" />
        <Preference
            app:key="channel_key_show"
            app:title="@string/pref_key_show_title"
            app:summary="@string/pref_key_show_summary" />
        <Preference
            app:key="channel_key_share"
            app:title="@string/pref_key_share_title"
            app:summary="@string/pref_key_share_summary" />
        <Preference
            app:key="channel_key_new"
            app:title="@string/pref_key_new_title"
            app:summary="@string/pref_key_new_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_talking">
        <SwitchPreferenceCompat
            app:key="full_duplex"
            app:title="@string/pref_full_duplex_title"
            app:defaultValue="false"
            app:summaryOn="@string/pref_full_duplex_on"
            app:summaryOff="@string/pref_full_duplex_off" />
        <ListPreference
            app:key="hw_button"
            app:title="@string/pref_hw_button_title"
            app:entries="@array/hw_button_entries"
            app:entryValues="@array/hw_button_values"
            app:defaultValue="both"
            app:dialogTitle="@string/pref_hw_button_dialog"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="hw_button_help"
            app:selectable="false"
            app:summary="@string/pref_hw_button_help" />
        <ListPreference
            app:key="audio_route"
            app:title="@string/pref_audio_route_title"
            app:entries="@array/audio_route_entries"
            app:entryValues="@array/audio_route_values"
            app:defaultValue="auto"
            app:dialogTitle="@string/pref_audio_route_dialog"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="headset_vox"
            app:title="@string/pref_headset_vox_title"
            app:defaultValue="false"
            app:summary="@string/pref_headset_vox_summary" />
        <SwitchPreferenceCompat
            app:key="proximity_sensor"
            app:title="@string/pref_proximity_title"
            app:defaultValue="true"
            app:summary="@string/pref_proximity_summary" />
        <SwitchPreferenceCompat
            app:key="cue_tones"
            app:title="@string/pref_cue_tones_title"
            app:defaultValue="false"
            app:summary="@string/pref_cue_tones_summary" />
        <SwitchPreferenceCompat
            app:key="headset_call"
            app:title="@string/pref_headset_call_title"
            app:defaultValue="false"
            app:summary="@string/pref_headset_call_summary" />
        <SwitchPreferenceCompat
            app:key="keep_screen_on"
            app:title="@string/pref_keep_screen_on_title"
            app:defaultValue="true"
            app:summary="@string/pref_keep_screen_on_summary" />
        <SwitchPreferenceCompat
            app:key="relay"
            app:title="@string/pref_relay_title"
            app:defaultValue="true"
            app:summary="@string/pref_relay_summary" />
        <SwitchPreferenceCompat
            app:key="opus"
            app:title="@string/pref_opus_title"
            app:defaultValue="true"
            app:summary="@string/pref_opus_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:key="ask_category" app:title="@string/pref_cat_ask">
        <SwitchPreferenceCompat
            app:key="ask_enabled"
            app:title="@string/pref_ask_enabled_title"
            app:defaultValue="false"
            app:summaryOn="@string/pref_ask_enabled_on"
            app:summaryOff="@string/pref_ask_enabled_off" />
        <ListPreference
            app:key="ask_mode"
            app:title="@string/pref_ask_mode_title"
            app:entries="@array/ask_mode_entries"
            app:entryValues="@array/ask_mode_values"
            app:defaultValue="just_me"
            app:dialogTitle="@string/pref_ask_mode_dialog"
            app:useSimpleSummaryProvider="true"
            app:dependency="ask_enabled" />
        <EditTextPreference
            app:key="ask_server"
            app:title="@string/pref_ask_server_title"
            app:dialogMessage="@string/pref_ask_server_message"
            app:dependency="ask_enabled" />
        <!-- Signal K's own device flow: the summary is set in SettingsActivity, because it
             reports what actually happened when this phone asked to be let in. -->
        <Preference
            app:key="ask_pair"
            app:title="@string/pref_ask_pair_title"
            app:dependency="ask_enabled" />
        <ListPreference
            app:key="ask_speed_unit"
            app:title="@string/pref_ask_speed_title"
            app:entries="@array/ask_speed_entries"
            app:entryValues="@array/ask_speed_values"
            app:defaultValue="knots"
            app:useSimpleSummaryProvider="true"
            app:dependency="ask_enabled" />
        <ListPreference
            app:key="ask_depth_unit"
            app:title="@string/pref_ask_depth_title"
            app:entries="@array/ask_depth_entries"
            app:entryValues="@array/ask_depth_values"
            app:defaultValue="metres"
            app:useSimpleSummaryProvider="true"
            app:dependency="ask_enabled" />
        <!-- Set in SettingsActivity to the privacy note, or to why this phone cannot ask by voice. -->
        <Preference
            app:key="ask_note"
            app:selectable="false"
            app:summary="@string/pref_ask_privacy" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_wlan">
        <EditTextPreference
            app:key="multicast_group"
            app:title="@string/pref_group_title"
            app:defaultValue="239.255.42.1"
            app:dialogMessage="@string/pref_group_message"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="lan_port"
            app:title="@string/pref_port_title"
            app:defaultValue="47474"
            app:dialogMessage="@string/pref_port_message"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_mesh">
        <EditTextPreference
            app:key="max_hops"
            app:title="@string/pref_hops_title"
            app:defaultValue="4"
            app:dialogMessage="@string/pref_hops_message"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>
