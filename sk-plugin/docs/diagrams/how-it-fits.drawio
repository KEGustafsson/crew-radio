<mxfile host="Electron" type="device"><diagram id="how-it-fits" name="how-it-fits"><mxGraphModel dx="1" dy="1" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="800" math="0" shadow="0" background="#F4F6F8"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#E6EEF0;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="800" as="geometry"/></mxCell><mxCell id="title" value="How signalk-crewradio fits in" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontColor=#1B2A33;fontFamily=Helvetica;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="36" width="900" height="44" as="geometry"/></mxCell><mxCell id="sub" value="The Signal K server becomes one more node on the crew&#x27;s channel, and speaks to it in its own voice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#5C6B75;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="82" width="1100" height="30" as="geometry"/></mxCell><mxCell id="alarms" value="Alarms in Signal K&lt;br&gt;anchor drag · man overboard · AIS · engine · depth" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1.5;fontSize=14;fontColor=#1B2A33;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="330" height="100" as="geometry"/></mxCell><mxCell id="say" value="Anything that can speak&lt;br&gt;Node-RED · dashboards · other plugins&lt;br&gt;PUT communication.crewradio.say&lt;br&gt;POST /plugins/signalk-crewradio/say" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;fontSize=14;fontColor=#1B2A33;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry