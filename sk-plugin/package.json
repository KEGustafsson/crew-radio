  "description": "Crew Radio: lets Signal K tell the sailing crew what matters, by voice, on their push-to-talk phones.",
  "main": "index.js",
  "license": "EUPL-1.2",
  "author": "Karl-Erik Gustafsson",
  "repository": {
    "type": "git",
    "url": "https://github.com/KEGustafsson/crew-radio.git",
    "directory": "sk-plugin"
  },
  "homepage": "https://github.com/KEGustafsson/crew-radio/tree/main/sk-plugin",
  "bugs": {
    "url": "https://github.com/KEGustafsson/crew-radio/issues"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-notifications",
    "crew-radio",
    "push-to-talk",
    "text-to-speech",
    "intercom"
  ],
  "engines": {
    "node": ">=22"
  },
  "signalk": {
    "displayName": "Crew Radio",
    "appIcon": "./icon.png",
    "screenshots": [
      "./screenshots/plugin-config.png",
      "./screenshots/webapp.png",
      "./screenshots/announcement.png",
      "./screenshots/data-browser.png",
      "./screenshots/how-it-fits.png"
    ]
  },
  "files": [
    "index.js",
    "lib/",
    "public/",
    "tools/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"tools/**\" --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=80"
  },
  "dependencies": {
    "@echogarden/flite-wasi": "0.1.1"
  }
